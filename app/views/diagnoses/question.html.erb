<div class="bg-gradient-to-br from-wine-950 via-wine-900 to-wine-800 flex items-start justify-center p-4 w-full">
  <div class="bg-wine-800 rounded-2xl shadow-2xl p-8 md:p-12 w-full">

    <!-- 質問 -->
    <div class="mb-8">
      <h2 class="text-2xl md:text-3xl font-bold mb-4 text-wine-000 border-b-2 border-wine-800 pb-2">
        <%= @question[:text] %>
      </h2>
    </div>

    <!-- 選択肢 -->
    <div class="space-y-4" data-controller="answer-animation">
      <% @question[:choices].each do |choice| %>
        <%= form_with url: diagnoses_answer_path(step: params[:step]),
                      method: :post,
                      local: true,
                      data: { answer_animation_target: 'form',
                              action: 'submit->answer-animation#submit' } do %>

          <%= hidden_field_tag :choice, choice[:id] %>

          <%= button_tag choice[:label],
                type: :submit,
                class: 'answer-btn w-full text-center text-wine-000 border-2 border-wine-800 font-semibold text-lg p-5 rounded-xl hover:bg-wine-900 transition ' %>
        <% end %>
      <% end %>
    </div>

    <!-- 装飾 -->
    <div class="mt-8 text-center">
      <span class="text-6xl">🍇</span>
    </div>
  </div>
</div>
